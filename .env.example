# Copy this file to .env (which git ignores) and set the address of your mem9
# server. Never commit the real address.
SHAREDMEM_API_URL=https://mem9.example.com

# The hosted mem9 service: set SHAREDMEM_API_URL to https://api.mem9.ai and
# create Chains through the mem9 Admin API. Create the Project and the Admin
# API key in the mem9 Console (https://mem9.ai/console). See
# docs/administrator-guide.md, "Before you start".
# SHAREDMEM_ADMIN_API_URL=https://console-api.mem9.ai
# SHAREDMEM_ADMIN_API_KEY=<an Admin API key with the space-chains:write scope>
# SHAREDMEM_PROJECT_ID=<the ID of a Project used only for this demo>

# A mem9 server you run yourself, only if it requires a create secret:
# SHAREDMEM_CREATE_SECRET=<the server's create secret>
